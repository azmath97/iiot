import RPi.GPIO as GPIO

from time import sleep

import RPLCD

from RPLCD import *

from RPLCD.gpio import CharLCD

GPIO.setwarnings(False)

GPIO.setmode(GPIO.BOARD)

lcd = CharLCD(
    cols=20,
    rows=2,
    pin_rs=7,
    pin_e=11,
    pins_data=[40, 38, 36, 32],
    numbering_mode=GPIO.BOARD
)

try:

    while True:

        state = GPIO.input(40)

        if state == 0:

            print("Gas Detected")

            lcd.cursor_pos = (0, 0)

            lcd.write_string("Gas")

            GPIO.output(35, 1)

        else:

            print("No Gas")

            lcd.cursor_pos = (0, 0)

            lcd.write_string("No Gas")

            GPIO.output(35, 0)

        sleep(1)

except KeyboardInterrupt:

    lcd.clear()

    GPIO.cleanup()
